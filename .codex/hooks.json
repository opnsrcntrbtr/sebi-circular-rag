{
  "hooks": {
    "Startup": [
      {
        "matcher": "Project",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/start_phoenix.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/graphify hook-check"
          }
        ]
      }
    ]
  }
}
